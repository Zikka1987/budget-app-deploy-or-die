# ============================================================
# Budget App - Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# === App ===
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                         # enable debug logging and auto-reload
API_HOST=0.0.0.0                       # bind address
API_PORT=8000                          # bind port
APP_SECRET_KEY=change-me-to-a-random-secret  # for signing internal tokens if needed

# === Database (direct Postgres via asyncpg) ===
# Plain postgresql:// URI — asyncpg connects directly, no ORM.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_POOL_MIN=2                    # minimum connections in asyncpg pool
DATABASE_POOL_MAX=10                   # maximum connections in asyncpg pool

# === Supabase (Auth + Storage only) ===
# The backend uses Supabase for JWT auth validation and receipt image storage.
# Database writes go through asyncpg, NOT the Supabase client.
#
# Auth uses the Supabase JWT signing-key flow. Tokens are verified against
# the project's JWKS document at:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# The legacy SUPABASE_JWT_SECRET (HS256 shared secret) is NO LONGER used.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key           # public, used for auth flows
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # BACKEND ONLY - never expose to client
SUPABASE_RECEIPTS_BUCKET=receipts                   # storage bucket name for receipt images

# Optional: override the JWKS URL if your project uses a non-standard path.
# Leave blank to derive from SUPABASE_URL. Default TTL is 1 hour.
# SUPABASE_JWKS_URL=
# JWKS_CACHE_TTL_SECONDS=3600

# === AI Provider (receipt OCR + categorization) ===
# AI is behind an abstract interface (ai/base.py). Anthropic is the first provider.
OCR_PROVIDER=anthropic                 # provider key; maps to concrete implementation
ANTHROPIC_API_KEY=your-anthropic-api-key  # BACKEND ONLY - never expose to client
OCR_MODEL=claude-sonnet-4-6            # model used for receipt image parsing
OCR_MAX_TOKENS=4096                    # max response tokens for OCR calls

# Categorization confidence threshold. AI suggestions at or above this level
# are trusted enough that the UI does not need to flag the individual item
# for extra attention. NOTE: this is a per-item UI hint only — the receipt
# still requires user review before any transactions are posted.
CATEGORIZATION_CONFIDENCE_THRESHOLD=0.85
